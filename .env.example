# 复制为 .env 后填写强随机值，不要提交 .env。
# 已泄露的旧值（WeldDB@2024#Secure!Pass、Redis@2024#Strong!Key、默认 JWT secret）禁止继续使用。

FRONTEND_URL=http://localhost:3000

POSTGRES_DB=weld_db
POSTGRES_USER=weld_user
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_DB_PASSWORD

REDIS_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_REDIS_PASSWORD

# 生产自动备份（秒 / 天）
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# 本地部署辅助脚本使用；优先使用 SSH key，不要把真实值提交到仓库。
WELD_SSH_HOST=your-server.example.com
WELD_SSH_USER=deploy
WELD_SSH_KEY=C:/Users/you/.ssh/id_ed25519
WELD_PROJECT_DIR=/home/ubuntu/weld-system
# WELD_SSH_PASSWORD=
